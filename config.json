{
  "hbase_shell_cmd": "hbase shell -n",
  "tables": {
    "user_table": {
      "columns": ["cf1:col1", "cf1:col2", "cf1:col3"],
      "queries": {
        "get_by_key": "get 'user_table', '{rowkey}'",
        "scan_all": "scan 'user_table'"
      }
    },
    "file_table": {
      "columns": ["cf1:fileId", "cf1:col1", "cf1:col2"],
      "queries": {
        "scan_by_fileid": "scan 'file_table', {FILTER=>\"SingleColumnValueFilter('cf1','fileId',=,'regexstring:.*{val}.*', true, true)\"}"
      }
    }
  }
}
